# Copy to .env and fill in. Never commit a real .env (GIT-1).
# Only the NAME of each variable belongs in version control.

# Local development database for the Task 3 schema proof.
# PostgreSQL 16, database "fixora".
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/fixora?schema=public"

# Required only to run `npm run db:seed` / `npm run proof`, both of which delete all rows first.
# Leave this unset in any shared or real environment so the seed refuses to run (GIT-4).
FIXORA_ALLOW_SEED_RESET=""

# Server-side only. Never a NEXT_PUBLIC_ name (SEC-9). Not used by Task 3 —
# no OTP code is ever issued or stored in plaintext (SEC-1).
OTP_HMAC_SECRET="placeholder-not-a-real-secret"
